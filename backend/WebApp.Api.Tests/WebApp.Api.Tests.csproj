<Project Sdk="MSTest.Sdk/3.10.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApp.Api\WebApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resolve ASP.NET Core assemblies from the shared framework (as WebApp.Api does) so NuGet prunes
         stale transitive packages pulled in by Microsoft.Identity.Web, e.g. Microsoft.AspNetCore.DataProtection
         and System.Security.Cryptography.Xml (GHSA-9mv3-2cwr-p262, GHSA-23rf-6693-g89p and related). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
